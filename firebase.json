{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "services/**",
      "app.py",
      "requirements.txt",
      "render.yaml",
      "netlify.toml"
    ],
    "rewrites": [
      { "source": "/gallery", "destination": "/prompt-gallery.html" },
      { "source": "/wishlist", "destination": "/profile.html" },
      { "source": "/payments", "destination": "/profile.html" },
      { "source": "/admin/dashboard", "destination": "/admin-dashboard.html" },
      { "source": "/p/**", "destination": "/portfolio-viewer.html" }
    ]
  }
}
